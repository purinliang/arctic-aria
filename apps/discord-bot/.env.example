# Required to register slash commands and send future Discord API messages.
# Secret bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Required to register slash commands.
# App ID from the Discord Developer Portal.
# Discord OAuth2 calls the same value Client ID; keep this one env name.
DISCORD_APP_ID=

# Required to verify HTTP interaction requests from Discord.
# Public Key from the Discord Developer Portal.
DISCORD_PUBLIC_KEY=

# Required for the current developer prototype binding.
# Developer's Discord account id. Do not use your Discord username here.
DISCORD_DEVELOPER_USER_ID=

# Required for the current developer prototype binding.
# Existing Arctic Aria username used by the developer in the web app.
ARCTIC_ARIA_DEVELOPER_USERNAME=

# Required for idea capture persistence.
# Use the same Neon database as the web app.
# If Vercel/Neon provides NEON_DATABASE_URL, copy that pooled URL here.
# The current bot code reads NEON_POSTGRES_URL only.
NEON_POSTGRES_URL=

# Optional local HTTP port for the interaction endpoint. Defaults to 3001.
# PORT=3001

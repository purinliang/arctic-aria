# Required for auth session signing in every environment, including local
# development. The app never falls back to the database URL or a default string.
# Generate a long random value and keep it secret.
AUTH_SESSION_SECRET=

# Required for database access and migrations.
# If Vercel/Neon provides NEON_DATABASE_URL, copy that pooled URL here.
# The current code reads NEON_POSTGRES_URL only.
NEON_POSTGRES_URL=

# Required to register slash commands and send Discord direct messages.
# Secret bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Required to register slash commands.
# App ID from the Discord Developer Portal.
# Discord OAuth2 calls the same value Client ID; keep this one env name.
DISCORD_APP_ID=

# Required to verify HTTP interaction requests from Discord.
# Public Key from the Discord Developer Portal.
# Set Discord Developer Portal -> Interactions Endpoint URL to:
# https://<web-host>/api/discord/interactions
DISCORD_PUBLIC_KEY=

# Required to accept private message-send requests from Arctic Aria services.
# Callers send this with Authorization: Bearer <DISCORD_MESSAGE_PUSH_SECRET>.
# Generate a separate random value; do not reuse auth or Discord secrets.
DISCORD_MESSAGE_PUSH_SECRET=

# Optional for Settings -> Discord -> Send Test.
# In local development, DISCORD_MESSAGE_PUSH_URL defaults to the local Next app
# route on http://localhost:3000. In Vercel production, the web app defaults to
# its own /api/internal/discord/messages route when VERCEL_URL is available.
DISCORD_MESSAGE_PUSH_URL=

# Optional app metadata overrides.
# Leave these empty locally; Next.js derives metadata from Git when possible.
# APP_RELEASE_VERSION=
# APP_BASE_VERSION=
# APP_VERSION=
# APP_COMMIT=
# APP_BRANCH=
# APP_SOURCE_STATE=

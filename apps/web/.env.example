# Local variables for `pnpm --dir apps/web dev`, `pnpm --dir apps/web deploy`,
# and other web scripts.
# Copy this file to `.env.local` and keep real values out of Git.

# Required for auth session signing in every environment, including local
# development. The app never falls back to the database URL or a default string.
# Generate a long random value and keep it secret.
AUTH_SESSION_SECRET=

# Required for database access and migrations.
# If Vercel/Neon provides NEON_DATABASE_URL, copy that pooled URL here.
# The current code reads NEON_POSTGRES_URL only.
NEON_POSTGRES_URL=

# Required to send Discord direct messages.
# Secret bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Required when running `pnpm --dir apps/web deploy` or
# `pnpm --dir apps/web discord:sync-commands`.
# App ID from the Discord Developer Portal.
DISCORD_APP_ID=

# Required to verify HTTP interaction requests from Discord.
# Public Key from the Discord Developer Portal.
# Set Discord Developer Portal -> Interactions Endpoint URL to:
# https://<web-host>/api/discord/interactions
DISCORD_PUBLIC_KEY=

# Optional local Discord development tunnel.
# Use a fixed ngrok domain when you have one.
# Set Discord Developer Portal -> Interactions Endpoint URL to:
# https://<web-host>/api/discord/interactions
DISCORD_NGROK_DOMAIN=

# Required for scheduled cron routes such as routine reminders.
# The Cloudflare cron worker sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional development CLI smoke test only; product users supply their own keys.
# Create the API key in Google AI Studio; keep real values in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required to save user-owned keys. Base64-encoded 32-byte AES encryption key.
# Generate locally with: node scripts/setup-ai-encryption.mjs
# Keep stable and separate from auth secrets; never expose through NEXT_PUBLIC_*.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Optional app metadata overrides.
# Leave these empty locally; Next.js derives metadata from Git when possible.
# APP_RELEASE_VERSION=
# APP_BASE_VERSION=
# APP_VERSION=
# APP_COMMIT=
# APP_BRANCH=
# APP_SOURCE_STATE=

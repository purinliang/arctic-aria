{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "arctic-aria-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "WEB_APP_BASE_URL": "https://arctic-aria.vercel.app"
  }
}
